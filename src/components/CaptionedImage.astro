---
const { caption } = Astro.props
---

<div class="rounded-xl border border-blue-200 bg-blue-50 p-3 rotate-2 sm:rotate-1 hover:rotate-0 transition my-2 flex flex-col items-center gap-3 duration-200 flex flex-1">
	<div class="bg-black/10 animate-pulse rounded-lg w-full h-42"></div>

	<p class="py-2">"{caption}"</p>
</div>
