---
import Card from "./Card.astro"

const { stars, message, person, company } = Astro.props;
---

<Card>
	<div class="flex flex-col gap-4">
		<div class="flex items-center gap-1">
			{Array.from({length: stars}, () => (<svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.399 8.167-7.333-3.853-7.333 3.853 1.399-8.167-5.934-5.787 8.2-1.192z"/></svg>)) }

			{Array.from({length: 5 - stars}, () => (<svg class="w-5 h-5 text-gray-200 fill-current" viewBox="0 0 24 24"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.399 8.167-7.333-3.853-7.333 3.853 1.399-8.167-5.934-5.787 8.2-1.192z"/></svg>)) }
		</div>

		<p>"{message}"</p>

		<hr class="border-gray-200 py-2"/>

		<div class="flex gap-4 items-center">
			<div class="rounded-full bg-gray-300 size-12 animate-pulse"></div>
			<div class="flex flex-col gap-1">
				<p class="font-bold">{person}</p>
				<p class="uppercase font-bold text-gray-300">{company}</p>
			</div>
		</div>
	</div>
</Card>

